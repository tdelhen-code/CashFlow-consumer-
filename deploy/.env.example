# Copy this file to .env next to compose.yaml and fill it in.
# docs/HOSTING.md explains each choice.

# Where the wallet is reached:
#   wallet.example.com  a domain whose DNS A record points at this server:
#                       Caddy gets and renews its HTTPS certificate by itself
#   localhost           to try it on this computer (Caddy's own certificate:
#                       the browser warns about it)
#   http://:80          behind the Cloudflare Tunnel, which gives the HTTPS
SITE_ADDRESS=localhost

# Which of this computer's addresses Caddy listens on: 0.0.0.0 on a server;
# 127.0.0.1 with the tunnel, so nobody on your network goes around it.
PUBLISH_IP=0.0.0.0

# Only with the tunnel (docker compose --profile tunnel up -d): the tunnel
# token from the Cloudflare dashboard. Keep it secret.
TUNNEL_TOKEN=

# The folder on this computer that gets the backups (every hour).
BACKUP_DIR=./backups

# Who owns the backup files: on Linux your own user and group ids (run
# `id -u` and `id -g`), so you can read them without sudo.
WALLET_UID=10001
WALLET_GID=10001

# Optional: a healthchecks.io (or similar) address, called after each hourly
# check and backup, with /fail added when something went wrong.
WALLET_PING_URL=
